{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set selectedSubnavItem = 'runs' %}
{% set title = run.uiLabel %}
{% set crumbs = [
    { label: 'Runs'|t('reportr'), url: url('reportr/runs') },
] %}

{% if report %}
    {% set crumbs = crumbs|merge([{ label: report.title, url: report.cpEditUrl }]) %}
{% endif %}

{% set params = run.describeParams() %}
{% set finished = run.runStatus in ['finished', 'error'] %}

{% if report %}
    {% set additionalButtons %}
        <a href="{{ report.runUrl }}" class="btn">{{ 'Run again'|t('reportr') }}</a>
    {% endset %}
{% endif %}

{% do view.registerTranslations('reportr', [
    'Delete this run and its file?',
    'Couldn’t delete the run.',
]) %}

{% block actionButton %}
    {% if canDownload and run.isDownloadable %}
        <a href="{{ run.downloadUrl }}" class="btn submit">{{ 'Download'|t('app') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    <div id="reportr-status">
        {% include 'reportr/runs/_status' with { run: run } only %}
    </div>

    {% if params|length %}
        <h2>{{ 'Parameters'|t('reportr') }}</h2>
        <table class="data fullwidth">
            <tbody>
                {% for label, value in params %}
                    <tr>
                        <th scope="row" class="thin">{{ label }}</th>
                        <td>{{ value }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if run.statusMessage %}
        <h2>{{ 'What happened'|t('reportr') }}</h2>
        <pre class="reportr-message">{{ run.statusMessage }}</pre>
    {% endif %}

    {% set points = [] %}
    {% for previous in history|reverse %}
        {% if previous.runStatus == 'finished' %}
            {% set points = points|merge([previous.totalRows]) %}
        {% endif %}
    {% endfor %}

    {% if points|length > 2 %}
        <h2>{{ 'Rows over the last {count} runs'|t('reportr', { count: points|length }) }}</h2>
        {# Drawn here rather than with a charting library: it is a polyline, and a report plugin
           that pulls in a charting bundle to draw one has made a poor trade. #}
        {% set maximum = max(points) ?: 1 %}
        {% set step = points|length > 1 ? 100 / (points|length - 1) : 100 %}
        {% set coordinates = [] %}
        {% for index, value in points %}
            {% set coordinates = coordinates|merge([(index * step)|round(2) ~ ',' ~ (30 - (value / maximum * 28))|round(2)]) %}
        {% endfor %}
        <svg viewBox="0 0 100 30" preserveAspectRatio="none" role="img"
             aria-label="{{ 'Rows written by each of the last {count} runs'|t('reportr', { count: points|length }) }}"
             style="width: 100%; height: 60px; overflow: visible;">
            <polyline points="{{ coordinates|join(' ') }}" fill="none" stroke="currentColor" stroke-width="0.8"
                      stroke-linejoin="round" stroke-linecap="round" opacity="0.7"></polyline>
        </svg>
        <p class="light">{{ 'Highest: {max} rows.'|t('reportr', { max: maximum|number }) }}</p>
    {% endif %}

    {% if history|length > 1 %}
        <h2>{{ 'Other runs of this report'|t('reportr') }}</h2>
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ 'When'|t('reportr') }}</th>
                    <th>{{ 'Status'|t('reportr') }}</th>
                    <th>{{ 'Rows'|t('reportr') }}</th>
                    <th>{{ 'Duration'|t('reportr') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for previous in history %}
                    <tr{{ previous.id == run.id ? ' class="sel"' : '' }}>
                        <td><a href="{{ url('reportr/runs/' ~ previous.id) }}">{{ (previous.dateFinished ?? previous.dateCreated)|datetime('short') }}</a></td>
                        <td>{% include 'reportr/runs/_status-dot' with { status: previous.runStatus } only %}{{ previous.statusLabel }}</td>
                        <td>{{ previous.totalRows|number }}</td>
                        <td>{{ previous.formattedDuration }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}

{% block details %}
    <dl class="meta read-only">
        <div class="data">
            <dt class="heading">{{ 'Status'|t('reportr') }}</dt>
            <dd class="value">{{ run.statusLabel }}</dd>
        </div>
        <div class="data">
            <dt class="heading">{{ 'Rows'|t('reportr') }}</dt>
            <dd class="value">{{ run.totalRows|number }}</dd>
        </div>
        <div class="data">
            <dt class="heading">{{ 'Size'|t('reportr') }}</dt>
            <dd class="value">{{ run.formattedSize }}</dd>
        </div>
        <div class="data">
            <dt class="heading">{{ 'Duration'|t('reportr') }}</dt>
            <dd class="value">{{ run.formattedDuration }}</dd>
        </div>
        {% if run.peakMemory %}
            <div class="data">
                <dt class="heading">{{ 'Peak memory'|t('reportr') }}</dt>
                <dd class="value">{{ run.peakMemory|filesize }}</dd>
            </div>
        {% endif %}
        <div class="data">
            <dt class="heading">{{ 'Started by'|t('reportr') }}</dt>
            <dd class="value">{{ run.initiatorLabels()[run.initiator] ?? run.initiator }}{% if run.user %} — {{ run.user.friendlyName }}{% endif %}</dd>
        </div>
        <div class="data">
            <dt class="heading">{{ 'Stored'|t('reportr') }}</dt>
            <dd class="value">{{ run.fsHandle ? run.fsHandle : 'Local storage'|t('reportr') }}{% if run.path %}<br><code class="small">{{ run.path }}</code>{% endif %}</dd>
        </div>
    </dl>

    {% if canDelete %}
        {# Posted from JavaScript: this screen has no page form for an action menu to post. #}
        <div class="meta">
            {{ forms.button({ id: 'reportr-delete-run', class: 'caution', label: 'Delete'|t('app'), spinner: true }) }}
        </div>
    {% endif %}
{% endblock %}

{% css %}
.reportr-message { white-space: pre-wrap; word-break: break-word; background: var(--gray-050); padding: var(--m); border-radius: var(--radius-md); }
{% endcss %}

{% js %}
(function() {
    var deleteButton = document.getElementById('reportr-delete-run');

    if (deleteButton) {
        deleteButton.addEventListener('click', function() {
            if (deleteButton.classList.contains('loading')) {
                return;
            }

            if (!confirm(Craft.t('reportr', 'Delete this run and its file?'))) {
                return;
            }

            deleteButton.classList.add('loading');

            Craft.sendActionRequest('POST', 'reportr/runs/delete', {
                data: { runId: {{ run.id }}, hardDelete: 1 }
            }).then(function() {
                window.location.href = Craft.getCpUrl('reportr/runs');
            }).catch(function() {
                deleteButton.classList.remove('loading');
                Craft.cp.displayError(Craft.t('reportr', 'Couldn’t delete the run.'));
            });
        });
    }

    {% if not finished %}
    // The page is watching a build that is still going. Polling rather than a socket, because a
    // report finishes once and the page is open for minutes, not hours.
    var poll = window.setInterval(function() {
        Craft.sendActionRequest('POST', 'reportr/runs/status', {
            data: { runId: {{ run.id }} }
        }).then(function(response) {
            if (response.data.finished) {
                window.clearInterval(poll);
                window.location.reload();
            }
        }).catch(function() {
            window.clearInterval(poll);
        });
    }, 3000);
    {% endif %}
})();
{% endjs %}
