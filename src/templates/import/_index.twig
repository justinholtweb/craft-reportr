{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set selectedSubnavItem = 'import' %}
{% set title = 'Import from Lab Reports'|t('reportr') %}
{% set crumbs = [{ label: 'Reportr'|t('reportr'), url: url('reportr/reports') }] %}

{% block content %}
    {% if not available %}
        <p>{{ 'No Lab Reports tables were found in this database, so there is nothing to import.'|t('reportr') }}</p>
    {% else %}
        <p>
            {{ 'Found {reports} configured reports and {runs} generated reports. {imported} have already been imported.'|t('reportr', {
                reports: counts.reports,
                runs: counts.runs,
                imported: counts.imported,
            }) }}
        </p>

        <div class="light">
            {{ 'Your report **templates do not need changing**. Reportr’s basic and advanced types call the same methods on the same `report` variable, and advanced reports keep using the formatting functions in `config/labreports.php`. Nothing in the Lab Reports tables is modified, and the import can safely be run twice — anything already brought across is skipped.'|t('reportr')|md }}
        </div>

        {% if legacyFolder %}
            <p class="light">{{ 'Report files will be copied from `{folder}`.'|t('reportr', { folder: legacyFolder })|md(inlineOnly=true) }}</p>
        {% else %}
            <p class="warning has-icon">
                <span class="icon" aria-hidden="true"></span>
                <span class="visually-hidden">{{ 'Warning:'|t('app') }}</span>
                <span>{{ 'The old report folder could not be found, so files will not be copied. The configurations and the history still import.'|t('reportr') }}</span>
            </p>
        {% endif %}

        <form method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('reportr/import/run') }}

            {# A lightswitch always posts a value; an unticked checkbox posts nothing, which the
               controller would read as its default of "yes". #}
            {{ forms.lightswitchField({
                label: 'Bring the run history across'|t('reportr'),
                name: 'includeRuns',
                on: true,
            }) }}

            {# A lightswitch always posts a value; an unticked checkbox posts nothing, which the
               controller would read as its default of "yes". #}
            {{ forms.lightswitchField({
                label: 'Copy the generated files'|t('reportr'),
                name: 'copyFiles',
                on: true,
            }) }}

            <div class="buttons">
                <button type="submit" name="dryRun" value="1" class="btn submit">{{ 'Dry run'|t('reportr') }}</button>
                <button type="submit" name="dryRun" value="0" class="btn">{{ 'Import'|t('reportr') }}</button>
            </div>
        </form>
    {% endif %}

    {% if summary %}
        <hr>
        <h2>{{ summary.dryRun ? 'What would happen'|t('reportr') : 'What happened'|t('reportr') }}</h2>

        <table class="data fullwidth">
            <tbody>
                <tr><th>{{ 'Reports imported'|t('reportr') }}</th><td>{{ summary.reportsImported }} {% if summary.reportsSkipped %}<span class="light">{{ '({count} already there)'|t('reportr', { count: summary.reportsSkipped }) }}</span>{% endif %}</td></tr>
                <tr><th>{{ 'Runs imported'|t('reportr') }}</th><td>{{ summary.runsImported }} {% if summary.runsSkipped %}<span class="light">{{ '({count} already there)'|t('reportr', { count: summary.runsSkipped }) }}</span>{% endif %}</td></tr>
                <tr><th>{{ 'Files copied'|t('reportr') }}</th><td>{{ summary.filesCopied }} {% if summary.filesMissing %}<span class="light">{{ '({count} missing)'|t('reportr', { count: summary.filesMissing }) }}</span>{% endif %}</td></tr>
            </tbody>
        </table>

        {% if summary.warnings|length %}
            <h3>{{ 'Warnings'|t('reportr') }}</h3>
            {% for warning in summary.warnings %}
                <p class="warning has-icon">
                    <span class="icon" aria-hidden="true"></span>
                    <span class="visually-hidden">{{ 'Warning:'|t('app') }}</span>
                    <span>{{ warning }}</span>
                </p>
            {% endfor %}
        {% endif %}

        {% if summary.log|length %}
            <h3>{{ 'Detail'|t('reportr') }}</h3>
            <ul>
                {% for line in summary.log %}<li>{{ line }}</li>{% endfor %}
            </ul>
        {% endif %}
    {% endif %}
{% endblock %}
