{
    "name": "justinholtweb/craft-reportr",
    "description": "Content and data reports for Craft CMS — template or point-and-click, with run-time parameters, seven export formats, scheduling, email delivery and storage on any filesystem.",
    "version": "5.0.1",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "reports",
        "reporting",
        "export",
        "csv",
        "xlsx",
        "data",
        "scheduled-reports",
        "lab-reports"
    ],
    "license": "proprietary",
    "homepage": "https://justinholt.com/plugins/craft-reportr",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "docs": "https://justinholt.com/plugins/craft-reportr/docs",
        "source": "https://github.com/justinholtweb/craft-reportr",
        "issues": "https://github.com/justinholtweb/craft-reportr/issues"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpstan/phpstan": "^1.12 || ^2.2"
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G"
    },
    "suggest": {
        "ext-zip": "Required for the XLSX export format."
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\reportr\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true,
            "craftcms/generator": true
        },
        "sort-packages": true
    },
    "extra": {
        "name": "Reportr",
        "handle": "reportr",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-reportr/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-reportr/main/CHANGELOG.md",
        "class": "justinholtweb\\reportr\\Plugin",
        "hasCpSettings": true
    }
}
