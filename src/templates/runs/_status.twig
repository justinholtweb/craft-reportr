<div class="reportr-status-banner">
    {% include 'reportr/runs/_status-dot' with { status: run.runStatus } only %}
    <span>
        {% if run.runStatus == 'finished' %}
            {{ '{rows} rows written to {filename}.'|t('reportr', { rows: run.totalRows|number, filename: run.filename }) }}
        {% elseif run.runStatus == 'error' %}
            {{ 'This run did not finish.'|t('reportr') }}
        {% elseif run.runStatus == 'running' %}
            {{ 'Building — {rows} rows so far.'|t('reportr', { rows: run.totalRows|number }) }}
        {% else %}
            {{ 'Queued. It will start when the queue next runs.'|t('reportr') }}
        {% endif %}
    </span>
</div>

{% css %}
.reportr-status-banner { display: flex; align-items: center; gap: var(--s); margin-bottom: var(--xl); }
{% endcss %}
